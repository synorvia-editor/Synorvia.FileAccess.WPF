<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <!-- Forked from oalt's MDD4All.FileAccess.WPF and renamed, so the two never meet in one build. Author and copyright stay his. -->
        <Version>2.0.0.0</Version>
        <Company>MDD4All.de</Company>
        <Description>WPF implementation of FileAccess contracts using IoC design pattern.</Description>
        <Copyright>(c) MDD4All.de</Copyright>
        <PackageReadmeFile>Nuget.md</PackageReadmeFile>
        <PackageTags>FileAccess WPF</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>Dr. Oliver Alt</Authors>
    </PropertyGroup>

    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
      <None Include="Nuget.md">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
    </ItemGroup>

    <!-- Waiting on a package: Synorvia.FileAccess.Contracts is not published yet. -->
    <ItemGroup>
        <ProjectReference Include="..\..\..\Synorvia.FileAccess.Contracts\src\Synorvia.FileAccess.Contracts\Synorvia.FileAccess.Contracts-dev.csproj" />
    </ItemGroup>

</Project>
